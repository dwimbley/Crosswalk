<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Crosswalk.App.dll" stdoutLogEnabled="true" stdoutLogFile="C:\temp\crosswalk-stdout" hostingModel="OutOfProcess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Development" />
          <environmentVariable name="CROSSWALK_DETAILED_ERRORS" value="true" />
          <environmentVariable name="CROSSWALK_DATA" value="C:\temp\crosswalk-data" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
